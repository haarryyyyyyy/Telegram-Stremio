# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# Optional: data centers to open Telegram media connections to at boot (default "1,2,4,5").
# Fewer = less memory per bot; "none" = open on first play (saves RAM, costs about a second on the first play per bot).
# PREWARM_DCS="1,2,4,5"

# Optional: disk space (MB) for caching the first and last 4 MB of played files, so replays and seeks
# start without a Telegram round trip. Uses disk, not RAM. 0 turns it off.
# CHUNK_CACHE_MB="1024"

# Optional: a Telegram user account (admin with "Delete messages" of the skip, storage and
# announcement channels) that deletes messages older than 48 hours, which bots cannot. Create it with:
#   uv run python scripts/make_user_session.py
# Full access to that account: keep this file private.
# USER_SESSION_STRING=""
