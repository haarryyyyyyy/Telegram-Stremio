# ==========================================
# Telegram Stremio V2 - Environment Settings
# ==========================================

# MongoDB Database URI & Name
MONGO_URI=mongodb://localhost:27017
DB_NAME=telegram_stremio_v2

# TMDB API Key for metadata & regional language aliasing (e.g., Telugu Sakhi -> TMDB 19169 Alaipayuthey)
# Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# TheTVDB v4 API Key (Optional, for advanced TV & anime series classification)
# Get a free key at: https://thetvdb.com/api-information
TVDB_API_KEY=your_tvdb_api_key_here

# Telegram MTProto API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Telegram Multi-Bot Tokens (Comma-separated or newline separated)
# Parallel chunk striping downloads across all bots concurrently for <300ms time-to-first-byte!
BOT_TOKENS=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz,0987654321:ZYXwvuTsRQPonMLkJIhGFEdCBA

# Channels to crawl & live-listen (Comma-separated chat IDs with -100 prefix or @usernames)
TELEGRAM_CHANNELS=-1001234567890,-1009876543210,@MyMediaChannel

# Public Base URL of this server (Used to generate Stremio stream & manifest links)
BASE_URL=http://localhost:8000

# Admin Dashboard Password
ADMIN_PASSWORD=admin123
